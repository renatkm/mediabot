# ── Required ──────────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ── Optional: restrict bot access ─────────────────────────────────────────────
# Comma-separated list of allowed Telegram chat IDs (leave empty to allow all)
# To find your chat ID: message @userinfobot on Telegram
ALLOWED_CHAT_IDS=

# ── qBittorrent ───────────────────────────────────────────────────────────────
# On first run, get the temp password from: docker logs media-qbittorrent
# Then log in at http://localhost:8080, change the password in Settings → Web UI
# and update this value
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=adminadmin

# ── Jackett ───────────────────────────────────────────────────────────────────
# After starting, open http://localhost:9117
# The API key is shown in the top-right corner
# Add RuTracker and NNM-Club indexers via "Add Indexer" (you need accounts there)
JACKETT_API_KEY=

# ── Jellyfin ──────────────────────────────────────────────────────────────────
# After first-time setup at http://localhost:8096:
#   Dashboard → API Keys → + → copy the key here
JELLYFIN_API_KEY=

# URL that users (outside Docker) use to open Jellyfin stream links
# Example: http://192.168.1.100:8096
JELLYFIN_PUBLIC_URL=

# Timezone
TZ=Europe/Moscow
